#!/usr/bin/env bash
# auto-claude pre-commit hook.
#
# Installed by session_boot.sh into .git/hooks/pre-commit. Refuses commits
# whose cwd or current branch don't match the active lease in
# .handoff/state.json. If no lease is active, allows the commit (so a human
# operator can commit normally outside auto-claude context).
#
# Exits 0 to allow the commit, 1 to block.

set -euo pipefail

repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
state_file="$repo_root/.handoff/state.json"

# Two operating modes:
#   - In-session: AUTO_CLAUDE_SESSION_ID is set (session_boot.sh exports it
#     before invoking claude). Inside a session, this hook is the LAST line
#     of defense — it MUST fail closed. If a subagent rm's state.json or
#     unsets jq from PATH, we refuse the commit instead of waving it through.
#   - Outside-session: AUTO_CLAUDE_SESSION_ID is unset. A human is committing
#     manually; preserve the friendly behavior of allowing commits when the
#     framework isn't running.
in_session=0
if [[ -n "${AUTO_CLAUDE_SESSION_ID:-}" ]]; then
    in_session=1
fi

if ! command -v jq >/dev/null 2>&1; then
    if (( in_session )); then
        echo "auto-claude pre-commit: jq not found in an auto-claude session — refusing commit" >&2
        echo "  (jq is required to verify the lease; install jq or unset AUTO_CLAUDE_SESSION_ID)" >&2
        exit 1
    fi
    echo "auto-claude pre-commit: jq not found; allowing commit (cannot verify lease)" >&2
    exit 0
fi

if [[ ! -f "$state_file" ]]; then
    if (( in_session )); then
        echo "auto-claude pre-commit: state.json missing in an auto-claude session — refusing commit" >&2
        echo "  expected: $state_file" >&2
        exit 1
    fi
    # No state file -> not under auto-claude management; allow.
    exit 0
fi

current_lease=$(jq -c '.current_lease // null' "$state_file" 2>/dev/null || echo "null")

if [[ "$current_lease" == "null" ]]; then
    if (( in_session )); then
        echo "auto-claude pre-commit: no current_lease in state.json during an auto-claude session — refusing commit" >&2
        echo "  (a session must hold a lease before committing; check .handoff/state.json)" >&2
        exit 1
    fi
    # No active lease -> allow (human is committing outside the framework).
    exit 0
fi

lease_branch=$(jq -r '.branch // empty' <<<"$current_lease")
lease_cwd=$(jq -r '.cwd_root // empty' <<<"$current_lease")
lease_task=$(jq -r '.task_id // empty' <<<"$current_lease")

current_branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo "DETACHED")
current_cwd="$(pwd -P)"

# Resolve symlinks on lease_cwd if possible so comparison is robust.
if [[ -n "$lease_cwd" && -d "$lease_cwd" ]]; then
    lease_cwd="$(cd "$lease_cwd" && pwd -P)"
fi

errors=()

if [[ -n "$lease_branch" && "$current_branch" != "$lease_branch" ]]; then
    errors+=("branch mismatch:")
    errors+=("    expected:  $lease_branch")
    errors+=("    actual:    $current_branch")
fi

if [[ -n "$lease_cwd" && "$current_cwd" != "$lease_cwd" ]]; then
    errors+=("cwd mismatch:")
    errors+=("    expected:  $lease_cwd")
    errors+=("    actual:    $current_cwd")
fi

if (( ${#errors[@]} > 0 )); then
    {
        echo "auto-claude pre-commit: REFUSING commit on lease '$lease_task'"
        for line in "${errors[@]}"; do
            echo "  $line"
        done
        echo
        echo "If you really need to bypass, the user can clear .handoff/state.json's"
        echo "current_lease field — but the watchdog will notice the inconsistency."
    } >&2
    exit 1
fi

exit 0
